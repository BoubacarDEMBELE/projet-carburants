# Copy to .env (git-ignored) to run locally. In GitHub Actions these come from repository secrets.
# Account identifier: Snowflake UI > bottom-left menu > Account > "Copy account identifier" (format ORGNAME-ACCOUNTNAME)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=FUEL_SVC
# Path to the private key file (key-pair authentication, no password)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=FUEL_WH
SNOWFLAKE_DATABASE=FUEL_DB
